{
  "name": "instabox-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --import ./tools/register-sql-loader.mjs --test tests/*.test.ts",
    "test:browser": "node tools/browser-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "worker:check": "wrangler deploy --dry-run --outdir dist/worker",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.d1.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.d1.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "secret:generate": "node tools/generate-secret.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "miniflare": "latest",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
